# Local development values. Replace the password before a public deployment.
POSTGRES_DB=volunteers
POSTGRES_USER=volunteers
POSTGRES_PASSWORD=volunteers-local-only
POSTGRES_PORT=5432

# Local JVM; the backend container uses port 8080 internally.
SERVER_PORT=8081

# Compose entry point. For a domain: SITE_ADDRESS=example.org, ports 80 and 443.
SITE_ADDRESS=:80
HTTP_PORT=8088
HTTPS_PORT=8443
SESSION_COOKIE_SECURE=false

# Enable only when calendar endpoints and server access checks are deployed.
# Compose passes this flag at frontend build time; rebuild web after changing it.
VITE_CALENDAR_API_ENABLED=false

# SMTP is disabled until configured. Use compose.mailpit.yaml for local testing.
MAIL_ENABLED=false
MAIL_FROM=noreply@example.invalid
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_SSL=false

# Telegram: create a bot with BotFather, then configure and enable.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_SITE_URL=http://localhost:8088
