# Local development values. Replace the password before a public deployment.
POSTGRES_DB=volunteers
POSTGRES_USER=volunteers
POSTGRES_PASSWORD=volunteers-local-only
POSTGRES_PORT=5432

# Local JVM; the backend container uses port 8080 internally.
SERVER_PORT=8081

# Compose entry point. For a domain: SITE_ADDRESS=example.org, ports 80 and 443.
SITE_ADDRESS=:80
HTTP_PORT=8088
HTTPS_PORT=8443
SESSION_COOKIE_SECURE=false
